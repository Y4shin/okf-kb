# KB index + config (the daemon's state — not KB content; gitignored per the deployment decision)
.kb/

# Node / npm workspace
node_modules/
dist/
build/
*.tsbuildinfo
# compiled test artifacts (tsc --build output under tests/)
packages/*/tests/**/*.js
packages/*/tests/**/*.d.ts
!packages/*/tests/**/*.test.ts
!packages/*/tests/**/*.test-d.ts

# Environment / secrets (never commit tokens)
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log

# Test artifacts
coverage/
.nyc_output/
