{
  "name": "@okf-kb/cli",
  "type": "module",
  "license": "MIT",
  "version": "0.1.1",
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "okfkb": "bin/okfkb.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@okf-kb/auth": "*",
    "@okf-kb/protocol": "*",
    "@trpc/client": "^11.18.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@okf-kb/fs": "*",
    "@okf-kb/daemon": "*",
    "@types/node": "^22",
    "typescript": "~5.9",
    "vitest": "^3"
  }
}
