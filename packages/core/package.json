{
  "name": "@okf-kb/core",
  "type": "module",
  "license": "MIT",
  "version": "0.1.2",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:negatives": "tsc --noEmit --strict --skipLibCheck --lib es2022 --module nodenext --moduleResolution nodenext --target es2022 tests/negatives.test-d.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^4.4"
  },
  "devDependencies": {
    "typescript": "~5.9",
    "vitest": "^3"
  }
}
